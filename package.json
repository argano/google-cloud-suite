{
  "name": "google-cloud-suite",
  "version": "0.0.1",
  "description": "A utilities for GCP",
  "scripts": {
    "clean": "lerna clean --yes && lerna run clean",
    "build:libs": "lerna run build --scope \"@google-cloud-suite/*\"",
    "build": "run-s build:libs",
    "test:libs": "lerna run test --concurrency 1 --scope \"@google-cloud-suite/*\"",
    "test": "run-s test:libs"
  },
  "author": "Argano Inc.",
  "license": "MIT",
  "devDependencies": {
    "lerna": "^9.0.7",
    "npm-run-all2": "^7.0.2"
  },
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
  },
  "resolutions": {
    "@tootallnate/once": "^3.0.1",
    "yaml": "^2.8.3",
    "brace-expansion": "^5.0.6",
    "uuid": "^11.1.1",
    "tmp": "^0.2.6"
  },
  "overrides": {
    "@tootallnate/once": "^3.0.1",
    "yaml": "^2.8.3",
    "brace-expansion": "^5.0.6",
    "uuid": "^11.1.1",
    "tmp": "^0.2.6"
  }
}
